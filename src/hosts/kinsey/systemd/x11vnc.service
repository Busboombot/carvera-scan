[Unit]
Description=x11vnc: share kinsey's desktop (:0, user carvera) on TCP 5900
After=display-manager.service
Requires=display-manager.service

[Service]
User=carvera
ExecStart=/usr/bin/x11vnc -display :0 -auth /home/carvera/.Xauthority -rfbauth /home/carvera/.vnc/passwd -rfbport 5900 -forever -shared -noxdamage -quiet
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
